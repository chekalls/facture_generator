@model FactureGenerator.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Inscription";
}

<h2>Créer un compte</h2>
<hr />

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-controller="Subscription" asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <fieldset class="mb-4">
                <legend class="h5">Informations personnelles</legend>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="FirstName" class="control-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="LastName" class="control-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                    <div class="form-text">8 caractères minimum, avec majuscule, minuscule, chiffre et caractère spécial.</div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ConfirmPassword" class="control-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="h5">Informations sur la société</legend>

                <div class="form-group mb-3">
                    <label asp-for="CompanyName" class="control-label"></label>
                    <input asp-for="CompanyName" class="form-control" autocomplete="organization" />
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CompanyAddress" class="control-label"></label>
                    <textarea asp-for="CompanyAddress" class="form-control" rows="3" autocomplete="street-address"></textarea>
                    <span asp-validation-for="CompanyAddress" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="CompanyNif" class="control-label"></label>
                        <input asp-for="CompanyNif" class="form-control" inputmode="numeric" maxlength="10" />
                        <span asp-validation-for="CompanyNif" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="CompanyStat" class="control-label"></label>
                        <input asp-for="CompanyStat" class="form-control" inputmode="numeric" maxlength="17" />
                        <span asp-validation-for="CompanyStat" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <button type="submit" class="btn btn-primary w-100">S'inscrire</button>
            <div class="mt-3 text-center">
                <span>Vous avez déjà un compte ? <a asp-controller="Authentication" asp-action="Index">Connectez-vous</a></span>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
