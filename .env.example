# Copier ce fichier en `.env` puis adapter les valeurs : cp .env.example .env
# Toutes les variables sont optionnelles : docker-compose.yml fournit des valeurs par défaut.

# --- Application ---
# Port HTTP publié sur la machine hôte (le conteneur écoute toujours sur 8080)
APP_PORT=8080
# Development | Production
ASPNETCORE_ENVIRONMENT=Production

# --- PostgreSQL ---
# Base créée au premier démarrage du conteneur db
POSTGRES_DB=facture_generator
POSTGRES_USER=postgres
# Attention : éviter les caractères ; $ " ' et les espaces (injectés dans la chaîne de connexion)
POSTGRES_PASSWORD=postgres
# Port publié sur 127.0.0.1 uniquement (accès client SQL depuis l'hôte)
DB_PORT=5432
